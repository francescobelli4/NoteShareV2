<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import java.net.URL?>
<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="notification" alignment="CENTER_LEFT" spacing="12"
      prefWidth="420" maxWidth="420" maxHeight="-Infinity">

    <stylesheets>
        <URL value="@../styles/notification.css"/>
    </stylesheets>

    <ImageView fx:id="image" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@../styles/icons/app_icon.png"/>
    </ImageView>

    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="titleLabel" text="Title" styleClass="subtitle"/>
        <Label fx:id="descriptionLabel" text="Description" styleClass="text-muted" wrapText="true"/>
    </VBox>
</HBox>
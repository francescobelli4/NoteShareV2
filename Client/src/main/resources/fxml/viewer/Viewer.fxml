<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="background" styleClass="viewer-background" maxWidth="Infinity" maxHeight="Infinity">

    <stylesheets>
        <URL value="@../styles/viewer.css"/>
    </stylesheets>

    <ScrollPane fx:id="scrollPane" styleClass="viewer-scroll" fitToWidth="true" maxWidth="Infinity" maxHeight="Infinity">
        <VBox fx:id="pagesBox" alignment="TOP_CENTER" spacing="16" styleClass="viewer-pages">
            <padding>
                <Insets bottom="24" left="24" right="24" top="24"/>
            </padding>
        </VBox>
    </ScrollPane>

    <Label fx:id="pageCounterLabel" styleClass="viewer-page-counter" mouseTransparent="true" StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets bottom="24"/>
        </StackPane.margin>
    </Label>

    <Button fx:id="closeButton" styleClass="viewer-close-button" StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets right="24" top="24"/>
        </StackPane.margin>
        <graphic>
            <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../styles/icons/x-button.png"/>
            </ImageView>
        </graphic>
    </Button>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

    <HBox alignment="CENTER_LEFT" spacing="8" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
        <stylesheets>
            <URL value="@../styles/explorer.css" />
        </stylesheets>

        <Button fx:id="backButton" disable="true" styleClass="icon-button">
            <graphic>
                <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../styles/icons/left-arrow.png" />
                </ImageView>
            </graphic>
        </Button>
        <Label fx:id="pathLabel" styleClass="text-muted" text="/">
         <font>
            <Font size="18.0" />
         </font></Label>
        <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="newFolderButton" styleClass="icon-button">
         <graphic>
             <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                 <Image url="@../styles/icons/folder_plus.png"/>
             </ImageView>
         </graphic>
      </Button>
      <Button fx:id="newNoteButton" styleClass="icon-button">
         <graphic>
             <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                 <Image url="@../styles/icons/file_plus.png"/>
             </ImageView>
         </graphic>
      </Button>
        <Button fx:id="copyButton" styleClass="icon-button" disable="true">
            <graphic>
                <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../styles/icons/file.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="pasteButton" styleClass="icon-button" disable="true">
            <graphic>
                <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../styles/icons/paste.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="deleteButton" styleClass="icon-button" disable="true">
            <graphic>
                <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../styles/icons/delete.png"/>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

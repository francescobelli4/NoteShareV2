<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      styleClass="auth-form" spacing="16" maxWidth="Infinity">

    <stylesheets>
        <URL value="@../styles/auth.css"/>
    </stylesheets>

    <VBox spacing="6">
        <Label text="Username" styleClass="form-label"/>
        <TextField fx:id="usernameField" promptText="Your Username"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Password" styleClass="form-label"/>
        <PasswordField fx:id="passwordField" promptText="Your Password"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

    <Button fx:id="loginButton" text="Login" styleClass="button-primary" maxWidth="Infinity"/>
</VBox>

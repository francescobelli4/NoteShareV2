<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="background" styleClass="dialog-background" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../styles/dialog.css"/>
    </stylesheets>
    <VBox styleClass="dialog-card" spacing="20" prefWidth="420" maxWidth="420" maxHeight="-Infinity">
        <Label fx:id="titleLabel" text="Title" styleClass="subtitle"/>

        <VBox fx:id="fieldsContainer" spacing="16"/>

        <Label fx:id="errorLabel" styleClass="dialog-error" wrapText="true" visible="false" managed="false"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" text="%cancel" styleClass="button-secondary"/>
            <Button fx:id="confirmButton" text="%confirm" styleClass="button-primary" defaultButton="true"/>
        </HBox>
    </VBox>
</StackPane>
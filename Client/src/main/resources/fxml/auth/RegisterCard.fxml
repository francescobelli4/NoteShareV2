<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      styleClass="auth-form" spacing="16" maxWidth="Infinity">

    <stylesheets>
        <URL value="@../styles/auth.css"/>
    </stylesheets>

    <VBox spacing="6">
        <Label text="Username" styleClass="form-label"/>
        <TextField fx:id="usernameField" promptText="Choose a username"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Password" styleClass="form-label"/>
        <PasswordField fx:id="passwordField" promptText="Choose a password"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Conferma password" styleClass="form-label"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Repeat the password"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Choose your role..." styleClass="form-label"/>
        <!-- https://stackoverflow.com/questions/35260061/combobox-items-via-scene-builder -->
        <ComboBox fx:id="roleComboBox" promptText="Select the role" maxWidth="Infinity">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Student"/>
                    <String fx:value="Teacher"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

    <Button fx:id="registerButton" text="Create Account" styleClass="button-primary" maxWidth="Infinity"/>
</VBox>
